# Nusxalashning o‘zi yetarli emas. scripts/setup_local.py lokal secretlarni yaratadi.
# Bo‘sh secret bilan startup fail-closed. Kalitlarni chatga yoki gitga qo‘ymang.
ENV=production
JWT_SECRET=
ADMIN_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ALLOW_INSECURE_DEV=false
PIPELINE_MODE=platform
# Membershipni har platform requestida server DB orqali tekshirish. Productionda o‘chirib bo‘lmaydi.
IDENTITY_DIRECTORY=true
IDENTITY_BOOTSTRAP_ENABLED=false
PACKS_DIR=../packs
# APP_DB=./data/app.db
# PLATFORM_INTEGRATIONS_FILE=../config/integrations.json
# PLATFORM_DB_ROOTS=["/srv/customer-db"]
# DEMO_AISHA_API_KEY=
# CORS_ORIGINS=https://your-app.example
